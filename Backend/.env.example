# Base de datos local (dev)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=TU_CONTRASENA
DB_NAME=Contratos_db

# En producción se usa DATABASE_URL (ej. Supabase/Render); si está definida, ignora
# las variables DB_* de arriba.
# DATABASE_URL=postgresql://usuario:password@host:5432/base

PORT=3000
JWT_SECRET=CAMBIAME_POR_UNA_CLAVE_SEGURA

# Google Gemini (IA para adaptar cláusulas)
# Clave de API desde https://aistudio.google.com
GEMINI_API_KEY=TU_CLAVE_DE_GEMINI
GEMINI_MODEL=gemini-3.5-flash

# Google Drive
# Ruta al archivo JSON de la cuenta de servicio (crearla en Google Cloud Console)
GOOGLE_SERVICE_ACCOUNT_PATH=./config/service-account-key.json
GOOGLE_DRIVE_FOLDER_ID=ID_CARPETA_DE_PLANTILLAS
GOOGLE_DRIVE_CONTRATOS_FOLDER_ID=ID_CARPETA_DE_CONTRATOS

# Google OAuth (cuenta personal del usuario para crear contratos)
# Crear credenciales en Google Cloud Console > APIs y servicios > Credenciales > Crear credenciales > ID de cliente OAuth > Aplicación web
GOOGLE_OAUTH_CLIENT_ID=TU_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=TU_CLIENT_SECRET
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback